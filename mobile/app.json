{
  "expo": {
    "name": "LeafDoc",
    "slug": "leafdoc",
    "scheme": "leafdoc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.leafdoc.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.leafdoc.app",
      "adaptiveIcon": {
        "backgroundColor": "#E3F1DF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F3F8F1",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0F1A12"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LeafDoc needs access to your photos so you can check a leaf picture you already took.",
          "cameraPermission": "LeafDoc uses the camera to photograph a leaf and identify the likely disease. Photos stay on your device.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "onnxruntime-react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "model": {
        "remoteUrl": null,
        "remoteMetaUrl": null
      }
    }
  }
}
